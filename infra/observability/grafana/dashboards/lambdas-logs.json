{
  "title": "Document Processing - Lambda Logs",
  "uid": "document-processing-lambda-logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "function_name",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(function_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Error log lines by function",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (function_name) (count_over_time({job=\"document-processing\", function_name=~\"$function_name\", level=\"ERROR\"} [$__interval]))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Lambda logs",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"document-processing\", function_name=~\"$function_name\"}"
        }
      ]
    }
  ]
}
