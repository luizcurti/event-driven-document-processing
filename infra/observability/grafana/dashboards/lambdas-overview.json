{
  "title": "Document Processing - Lambdas Overview",
  "uid": "document-processing-lambdas",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Invocation rate by function",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (function_name) (rate(lambda_invocations_total[5m]))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate by function",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (function_name) (rate(lambda_invocations_total{status=\"error\"}[5m]))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 invocation duration by function",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (function_name, le) (rate(lambda_invocation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{function_name}}"
        }
      ]
    }
  ]
}
