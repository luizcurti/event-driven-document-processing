{
  "name": "document-processing-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven document processing platform on AWS.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration:local": "node tests/integration/local-e2e.mjs",
    "test:api:local": "./scripts/run-postman-local.sh",
    "package:local": "npm run clean && npm run check && node scripts/bundle-lambdas.mjs && (cd dist && zip -rq lambda.zip .)",
    "local:setup": "./scripts/local-up.sh",
    "local:teardown": "./scripts/local-down.sh",
    "local:check": "./scripts/local-check.sh",
    "localstack:up": "docker compose -f docker-compose.local.yml up -d",
    "localstack:down": "docker compose -f docker-compose.local.yml down -v"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1124.0",
    "@aws-sdk/client-lambda": "^3.1124.0",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/client-sfn": "^3.1124.0",
    "@aws-sdk/client-sns": "^3.1124.0",
    "@aws-sdk/client-sqs": "^3.1124.0",
    "@aws-sdk/client-textract": "^3.1124.0",
    "@aws-sdk/lib-dynamodb": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
